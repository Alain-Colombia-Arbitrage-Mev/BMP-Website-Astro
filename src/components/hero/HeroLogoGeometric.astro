---
// Logo BMP geométrico central (diamante azul)
---

<div class="hero-logo-geometric">
  <img src="/Logo-bmp.svg" alt="BeMind Power Logo" />
</div>

<style>
  .hero-logo-geometric {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(590px, 50vw);
    z-index: 2;
    pointer-events: none;
  }

  .hero-logo-geometric img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    .hero-logo-geometric {
      width: min(450px, 45vw);
    }
  }

  @media (max-width: 768px) {
    .hero-logo-geometric {
      width: min(350px, 55vw);
    }
  }

  @media (max-width: 480px) {
    .hero-logo-geometric {
      width: min(260px, 65vw);
    }
  }
</style>
