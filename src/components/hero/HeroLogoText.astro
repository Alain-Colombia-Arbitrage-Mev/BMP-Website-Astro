---

<div class="hero-logo-text">
  <img src="/images/LOGOBLANCO.svg" alt="BeMind Power" />
</div>

<style>
  .hero-logo-text {
    width: min(250px, 28vw);
    margin-bottom: 1.2vh;
    position: relative;
    z-index: 20;
  }

  .hero-logo-text img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero-logo-text {
      width: min(200px, 40vw);
      margin-bottom: 0.8vh;
    }
  }

  @media (max-width: 480px) {
    .hero-logo-text {
      width: min(165px, 42vw);
      margin-bottom: 0.7vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-logo-text {
      width: min(150px, 40vw);
      margin-bottom: 0.6vh;
    }
  }
</style>
