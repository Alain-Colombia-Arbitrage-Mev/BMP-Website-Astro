---

<div class="hero-logo-text">
  <img src="/images/LOGOBLANCO.svg" alt="BeMind Power" />
</div>

<style>
  .hero-logo-text {
    width: min(320px, 35vw);
    margin-bottom: 1.5vh;
    position: relative;
    z-index: 20;
  }

  .hero-logo-text img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 768px) {
    .hero-logo-text {
      width: min(240px, 48vw);
      margin-bottom: 1.2vh;
    }
  }

  @media (max-width: 480px) {
    .hero-logo-text {
      width: min(200px, 50vw);
      margin-bottom: 1vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-logo-text {
      width: min(180px, 48vw);
      margin-bottom: 0.8vh;
    }
  }
</style>
