---
// Título de bienvenida
interface Props {
  text?: string;
}

const { text = "Te damos la Bienvenida" } = Astro.props;
---

<div class="hero-welcome-title">{text}</div>

<style>
  .hero-welcome-title {
    color: #ffffff;
    font-family: 'OPTIFutura', 'Inter', sans-serif;
    font-size: clamp(20px, 3vw, 34px);
    font-weight: 900;
    text-align: center;
    margin: 0 0 1vh 0;
    padding: 0 5vw;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  @media (max-width: 768px) {
    .hero-welcome-title {
      font-size: clamp(19px, 4.2vw, 28px);
      letter-spacing: 1.1px;
      margin-bottom: 1vh;
    }
  }

  @media (max-width: 480px) {
    .hero-welcome-title {
      font-size: 17px;
      line-height: 1.3;
      letter-spacing: 0.9px;
      margin-bottom: 0.8vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-welcome-title {
      font-size: 16px;
      letter-spacing: 0.7px;
      margin-bottom: 0.7vh;
    }
  }
</style>
