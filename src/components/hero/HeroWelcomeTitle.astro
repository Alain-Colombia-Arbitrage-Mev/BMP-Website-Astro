---
// Título de bienvenida
interface Props {
  text?: string;
}

const { text = "Te damos la Bienvenida" } = Astro.props;
---

<div class="hero-welcome-title">{text}</div>

<style>
  .hero-welcome-title {
    color: #ffffff;
    font-family: 'OPTIFutura', 'Inter', sans-serif;
    font-size: clamp(28px, 4.5vw, 48px);
    font-weight: 900;
    text-align: center;
    margin: 0 0 2vh 0;
    padding: 0 5vw;
    text-transform: uppercase;
    letter-spacing: 2px;
  }

  @media (max-width: 768px) {
    .hero-welcome-title {
      font-size: clamp(22px, 5vw, 32px);
      letter-spacing: 1.5px;
      margin-bottom: 1.5vh;
    }
  }

  @media (max-width: 480px) {
    .hero-welcome-title {
      font-size: 20px;
      line-height: 1.3;
      letter-spacing: 1px;
      margin-bottom: 1.2vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-welcome-title {
      font-size: 18px;
      letter-spacing: 0.8px;
      margin-bottom: 1vh;
    }
  }
</style>
