---
// Título principal del hero
interface Props {
  text?: string;
}

const { text = "A una experiencia sin precedentes" } = Astro.props;
---

<h1 class="hero-title">{text}</h1>

<style>
  .hero-title {
    color: #ffffff;
    font-family: 'Neometric', 'Inter', sans-serif;
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 400;
    line-height: 1.6;
    text-align: center;
    margin: 0 0 1.5vh 0;
    padding: 0 5vw;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(18px, 4vw, 28px);
      line-height: 1.5;
      margin-bottom: 1.2vh;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 17px;
      line-height: 1.4;
      margin-bottom: 1vh;
      padding: 0 6vw;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-title {
      font-size: 16px;
      line-height: 1.3;
      margin-bottom: 0.8vh;
    }
  }
</style>
