---
// Título principal del hero
interface Props {
  text?: string;
}

const { text = "A una experiencia sin precedentes" } = Astro.props;
---

<h1 class="hero-title">{text}</h1>

<style>
  .hero-title {
    color: #ffffff;
    font-family: 'Neometric', 'Inter', sans-serif;
    font-size: clamp(17px, 2.5vw, 29px);
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
    margin: 0 0 1vh 0;
    padding: 0 5vw;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(16px, 3.2vw, 24px);
      line-height: 1.35;
      margin-bottom: 0.9vh;
    }
  }

  @media (max-width: 480px) {
    .hero-title {
      font-size: 15px;
      line-height: 1.3;
      margin-bottom: 0.7vh;
      padding: 0 6vw;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-title {
      font-size: 14px;
      line-height: 1.3;
      margin-bottom: 0.6vh;
    }
  }
</style>
