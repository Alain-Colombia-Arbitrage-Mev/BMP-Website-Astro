---
// Teléfono (imagen + rotación)
interface Props {
  src?: string;
  rotation?: number;
}

const { 
  src = "/images/telefono.png",
  rotation = -10
} = Astro.props;
---

<div class="hero-phone" style={`--rotation: ${rotation}deg`}>
  <img src={src} alt="Teléfono BeMind" />
</div>

<style>
  .hero-phone {
    position: absolute;
    left: 50%;
    bottom: -35%;
    transform: translateX(-50%) rotate(var(--rotation, -10deg));
    width: clamp(420px, 38vw, 550px);
    z-index: 25;
    pointer-events: none;
  }

  /* Laptops medianas (13"-15") */
  @media (min-width: 1280px) and (max-height: 900px) {
    .hero-phone {
      bottom: -40%;
      width: clamp(400px, 36vw, 520px);
    }
  }

  @media (min-width: 1440px) {
    .hero-phone {
      width: clamp(500px, 42vw, 680px);
      bottom: -30%;
    }
  }

  @media (min-width: 1920px) {
    .hero-phone {
      width: clamp(560px, 44vw, 750px);
      bottom: -28%;
    }
  }

  .hero-phone img {
    width: 100%;
    height: auto;
  }

  @media (max-width: 1024px) {
    .hero-phone {
      width: min(480px, 42vw);
      bottom: -18%;
    }
  }

  @media (max-width: 768px) {
    .hero-phone {
      width: min(420px, 65vw);
      bottom: -18%;
    }
  }

  @media (max-width: 480px) {
    .hero-phone {
      width: min(380px, 75vw);
      bottom: -15%;
    }
  }
</style>
