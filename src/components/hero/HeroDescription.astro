---
// Texto descriptivo del hero
interface Props {
  text?: string;
}

const { text = "Aquí no solo tienes una app. Tienes tu red sin complicaciones: escribe, compra, paga, explora y transforma tu día… con la claridad de Be Mind Power." } = Astro.props;
---

<p class="hero-description">{text}</p>

<style>
  .hero-description {
    color: #ffffff;
    font-family: 'Neometric', 'Inter', sans-serif;
    font-size: clamp(13px, 1.35vw, 18px);
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    margin: 0 0 2vh 0;
    padding: 0 5vw;
    max-width: 750px;
  }

  @media (max-width: 768px) {
    .hero-description {
      font-size: clamp(12px, 2.3vw, 16px);
      line-height: 1.4;
      max-width: 600px;
      margin-bottom: 1.5vh;
    }
  }

  @media (max-width: 480px) {
    .hero-description {
      font-size: 12px;
      padding: 0 6vw;
      line-height: 1.35;
      margin-bottom: 1.3vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-description {
      font-size: 11px;
      line-height: 1.3;
      margin-bottom: 1.2vh;
      padding: 0 7vw;
    }
  }
</style>
