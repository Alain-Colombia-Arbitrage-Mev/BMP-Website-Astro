---
// Texto descriptivo del hero
interface Props {
  text?: string;
}

const { text = "Aquí no solo tienes una app. Tienes tu red sin complicaciones: escribe, compra, paga, explora y transforma tu día… con la claridad de Be Mind Power." } = Astro.props;
---

<p class="hero-description">{text}</p>

<style>
  .hero-description {
    color: #ffffff;
    font-family: 'Neometric', 'Inter', sans-serif;
    font-size: clamp(16px, 1.8vw, 24px);
    font-weight: 400;
    line-height: 1.6;
    text-align: center;
    margin: 0 0 3vh 0;
    padding: 0 5vw;
    max-width: 900px;
  }

  @media (max-width: 768px) {
    .hero-description {
      font-size: clamp(14px, 2.8vw, 18px);
      line-height: 1.5;
      max-width: 700px;
      margin-bottom: 2.5vh;
    }
  }

  @media (max-width: 480px) {
    .hero-description {
      font-size: 14px;
      padding: 0 7vw;
      line-height: 1.45;
      margin-bottom: 2vh;
    }
  }

  /* iPhone SE y pantallas muy pequeñas */
  @media (max-width: 375px) {
    .hero-description {
      font-size: 13px;
      line-height: 1.4;
      margin-bottom: 1.8vh;
      padding: 0 8vw;
    }
  }
</style>
