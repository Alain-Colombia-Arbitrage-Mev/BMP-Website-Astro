---
interface Props {
  image: string;
  logo: string;
  title: string;
  description: string;
  titleKey?: string;
  descriptionKey?: string;
}

const { image, logo, title, description, titleKey, descriptionKey } = Astro.props;
---

<div class="feature-card group relative w-[220px] sm:w-[320px] flex flex-col overflow-visible cursor-pointer transition-all duration-500 hover:scale-105">
  <!-- IMAGEN SUPERIOR (sobresale hacia arriba) -->
  <div class="card-image-container">
    <img 
      src={image} 
      alt={title}
      class="card-image"
    />
  </div>

  <!-- PARTE SUPERIOR (fondo de la tarjeta) -->
  <div class="card-top relative rounded-t-[10px] h-[160px] sm:h-[260px]">
  </div>

  <!-- VIÑETAS (entre parte superior e inferior) -->
  <div class="vignettes-container relative h-0">
    <!-- Viñeta izquierda -->
    <img src="/images/vignette-left.svg" alt="" class="card-vignette card-vignette-left" aria-hidden="true" />
    <!-- Viñeta derecha -->
    <img src="/images/vignette-right.svg" alt="" class="card-vignette card-vignette-right" aria-hidden="true" />
  </div>

  <!-- PARTE INFERIOR -->
  <div class="card-bottom relative rounded-b-[10px] p-3 sm:p-4 pb-4 sm:pb-5 overflow-hidden">
    <!-- Título con Logo -->
    <div class="flex items-center gap-2 mb-1">
      <h3 class="card-title text-white flex-shrink-0">
        <span data-i18n={titleKey}>{title}</span>
      </h3>
      <!-- Logo al lado del título -->
      <img 
        src={logo} 
        alt="Logo"
        class="card-logo"
      />
    </div>

    <!-- Descripción -->
    <p class="card-description text-white">
      <span data-i18n={descriptionKey}>{description}</span>
    </p>
  </div>

  <!-- Efecto de brillo en hover -->
  <div class="absolute inset-0 rounded-[10px] opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none glow-effect"></div>
</div>

<style>
  .feature-card {
    perspective: 1000px;
    padding-top: 80px; /* Espacio para que la imagen sobresalga */
  }

  @media (min-width: 640px) {
    .feature-card {
      padding-top: 120px;
    }
  }

  /* CONTENEDOR DE IMAGEN (sobresale hacia arriba) */
  .card-image-container {
    position: absolute;
    top: -20px;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    z-index: 5;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  @media (min-width: 640px) {
    .card-image-container {
      top: -40px;
      width: 115%;
    }
  }

  .card-image {
    width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: contain;
    object-position: center bottom;
  }

  @media (min-width: 640px) {
    .card-image {
      max-height: 380px;
    }
  }

  /* PARTE SUPERIOR */
  .card-top {
    background: rgba(134, 20, 190, 0.5);
    border: 1px solid rgba(82, 25, 191, 0.5);
    border-bottom: none;
    overflow: hidden;
  }

  /* PARTE INFERIOR */
  .card-bottom {
    background: rgba(108, 23, 191, 0.5);
    border: 1px solid rgba(82, 25, 191, 0.5);
    border-top: none;
  }

  .card-title {
    font-family: 'OPTIFutura', sans-serif;
    font-weight: 900;
    text-transform: capitalize;
    font-size: 24px;
    line-height: 28px;
  }

  @media (min-width: 640px) {
    .card-title {
      font-size: 40px;
      line-height: 44px;
    }
  }

  .card-logo {
    height: 20px;
    width: auto;
    opacity: 0.8;
    flex-shrink: 0;
  }

  @media (min-width: 640px) {
    .card-logo {
      height: 32px;
    }
  }

  .card-description {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 10px;
    line-height: 1.3;
    max-width: 100%;
    opacity: 0.9;
  }

  @media (min-width: 640px) {
    .card-description {
      font-size: 14px;
      line-height: 1.4;
    }
  }

  .feature-card:hover {
    filter: drop-shadow(0 25px 50px rgba(139, 92, 246, 0.3));
  }

  .glow-effect {
    background: linear-gradient(to top, rgba(139, 92, 246, 0.15), transparent);
  }

  /* Contenedor de viñetas */
  .vignettes-container {
    position: relative;
    z-index: 20;
  }

  /* Viñetas decorativas */
  .card-vignette {
    position: absolute;
    pointer-events: none;
  }

  .card-vignette-left {
    left: -4px;
    top: 50%;
    transform: translateY(-50%);
    width: 14px;
    height: auto;
  }

  .card-vignette-right {
    right: -20px;
    top: 50%;
    transform: translateY(-50%);
    width: auto;
    height: 60px;
  }

  @media (min-width: 640px) {
    .card-vignette-right {
      right: -28px;
      height: 100px;
    }
  }
</style>
