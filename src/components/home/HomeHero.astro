---
// Página home: hero compuesto por componentes pequeños e inspeccionables por separado.
import HomeHeroBackground from './HomeHeroBackground.astro';
import HomeHeroSliderLayer from './HomeHeroSliderLayer.astro';
import HomeHeroOverlay from './HomeHeroOverlay.astro';

interface Props {
  videoSrc?: string;
  phoneSrc?: string;
}

const { videoSrc, phoneSrc } = Astro.props;
---

<div class="home-hero">
  <HomeHeroBackground videoSrc={videoSrc} />
  <HomeHeroSliderLayer>
    <slot />
  </HomeHeroSliderLayer>
  <HomeHeroOverlay phoneSrc={phoneSrc} />
</div>

<style>
  .home-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 100dvh;
    overflow: hidden;
  }
</style>
