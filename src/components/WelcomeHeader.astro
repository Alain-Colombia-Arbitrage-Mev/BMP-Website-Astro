---
const navItems = [
  { href: "/", label: "Inicio", key: "nav.home", isActive: true },
  {
    href: "/about",
    label: "Sobre nosotros",
    key: "nav.about",
    isActive: false,
  },
  { href: "/contact", label: "Contacto", key: "nav.contact", isActive: false },
];
---

<header
  class="welcome-header absolute left-0 right-0 top-6 z-50 px-[6%] max-lg:px-[5%] max-sm:px-4"
>
  <div class="header-glass-wrap mx-auto max-w-[1508px]">
    <nav
      class="header-glass rounded-[46px] px-8 flex items-center justify-between max-lg:px-6 h-[70px] max-lg:h-14"
    >
      <!-- Logo izquierda -->
      <a
        href="/"
        class="flex items-center gap-2.5 no-underline shrink-0 max-sm:hidden"
      >
        <img
          src="/Logo_Be-Mind%20night.svg"
          alt="BeMind Power"
          class="h-12 w-auto max-lg:h-10"
        />
      </a>

      <!-- Navegación centrada (Desktop) -->
      <div
        class="absolute left-1/2 -translate-x-1/2 hidden md:flex items-center gap-9 max-lg:gap-6"
      >
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "text-white no-underline text-[17px] max-lg:text-[15px] transition-opacity hover:opacity-90",
                item.isActive ? "font-black" : "font-normal",
              ]}
            >
              <span data-i18n={item.key}>{item.label}</span>
            </a>
          ))
        }
      </div>

      <!-- Botones derecha (Desktop) -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/registro"
          class="btn-registro px-6 py-2.5 rounded-full text-white font-semibold text-[15px] no-underline transition-all hover:brightness-110 active:scale-[0.98]"
        >
          <span data-i18n="nav.register">Registro</span>
        </a>
        <a
          href="/login"
          class="btn-login px-6 py-2.5 rounded-full text-white font-semibold text-[15px] no-underline transition-all hover:brightness-110 active:scale-[0.98]"
        >
          <span data-i18n="nav.login">Login</span>
        </a>
      </div>

      <!-- Móvil: logo + hamburguesa -->
      <div class="md:hidden flex items-center justify-between w-full">
        <a href="/" class="flex items-center gap-2 no-underline">
          <img
            src="/Logo_Be-Mind%20night.svg"
            alt="BeMind Power"
            class="h-9 w-auto"
          />
        </a>
        <button
          id="hamburger-btn"
          class="hamburger-button flex items-center justify-center w-10 h-10 rounded-xl text-white bg-white/5 border border-white/20 transition-colors hover:bg-white/10"
          type="button"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <svg
            class="hamburger-icon w-5 h-5"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="close-icon w-5 h-5 hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Menú móvil -->
  <div
    id="mobile-menu"
    data-open="false"
    class="mobile-menu-panel md:hidden mx-4 mt-3 rounded-2xl border border-white/10 bg-black/80 backdrop-blur-xl px-4 py-4 opacity-0 translate-y-[-8px] scale-[0.98] pointer-events-none transition-all duration-300 max-h-0 overflow-hidden"
  >
    <nav class="w-full" aria-label="Mobile">
      <div class="flex flex-col items-center gap-1">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "mobile-menu-item text-white text-[15px] py-2.5 px-4 rounded-xl hover:bg-white/10 transition-colors w-full text-center no-underline",
                item.isActive ? "font-bold" : "font-normal",
              ]}
            >
              <span data-i18n={item.key}>{item.label}</span>
            </a>
          ))
        }
      </div>
    </nav>
    <div class="w-full h-px bg-white/10 my-3"></div>
    <div class="flex flex-col gap-2 w-full">
      <a
        href="/registro"
        class="btn-registro w-full py-3 rounded-full text-white font-semibold text-[14px] text-center no-underline"
      >
        <span data-i18n="nav.register">Registro</span>
      </a>
      <a
        href="/login"
        class="btn-login w-full py-3 rounded-full text-white font-semibold text-[14px] text-center no-underline"
      >
        <span data-i18n="nav.login">Login</span>
      </a>
    </div>
  </div>
</header>

<style>
  /* Navbar con glassmorphism mejorado */
  .header-glass {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 46px;
    box-shadow: 
      0 4px 30px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .btn-registro {
    background: #a713bf; /* Exact hex from Figma */
    /* Remove shadow if not in design, but keeping for flair if not contradicting */
    box-shadow: 0 4px 14px rgba(167, 19, 191, 0.4);
  }

  .btn-login {
    background: #1929ff; /* Exact hex from Figma */
    box-shadow: 0 4px 14px rgba(25, 41, 255, 0.4);
  }

  .mobile-menu-panel[data-open="true"] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    max-height: 380px;
  }

  .hamburger-button[aria-expanded="true"] .hamburger-icon {
    display: none;
  }
  .hamburger-button[aria-expanded="true"] .close-icon {
    display: block;
  }
</style>

<script>
  import { $menuOpen, toggleMenu, closeMenu } from "../stores";

  function initWelcomeMenu(): void {
    const hamburgerBtn = document.getElementById("hamburger-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    if (!hamburgerBtn || !mobileMenu) return;
    if (hamburgerBtn.hasAttribute("data-initialized")) return;
    hamburgerBtn.setAttribute("data-initialized", "true");

    $menuOpen.subscribe((isOpen) => {
      mobileMenu.setAttribute("data-open", String(isOpen));
      hamburgerBtn.setAttribute("aria-expanded", String(isOpen));
    });

    hamburgerBtn.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });
    mobileMenu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => closeMenu()));
    document.addEventListener("click", (e) => {
      const target = e.target as Node;
      if (!hamburgerBtn.contains(target) && !mobileMenu.contains(target))
        closeMenu();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && $menuOpen.get()) closeMenu();
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initWelcomeMenu);
  } else {
    initWelcomeMenu();
  }
  document.addEventListener("astro:page-load", initWelcomeMenu);
</script>
