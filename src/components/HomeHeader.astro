---
import LanguageSwitcher from './LanguageSwitcher.astro';

const navItems = [
  { href: '/', label: 'Inicio', key: 'nav.home', isActive: true },
  { href: '/about', label: 'Sobre nosotros', key: 'nav.about', isActive: false },
  { href: '/contact', label: 'Contacto', key: 'nav.contact', isActive: false }
];
---

<header class="site-header absolute left-0 right-0 top-6 z-50 px-[6%] max-lg:px-[5%] max-sm:px-4">
  <div class="header-glass-wrap mx-auto max-w-[1508px]">
    <div class="header-glass relative flex items-center justify-between h-[70px] max-lg:h-14 rounded-[46px] px-8 max-lg:px-6 max-sm:rounded-2xl max-sm:px-4 max-sm:h-auto max-sm:py-3">
      <a href="/" class="flex items-center gap-2.5 no-underline shrink-0 max-sm:hidden" aria-label="BeMind Power - Inicio">
        <img
          src="/images/logos/Logo_Be-Mind%20night.svg"
          alt="BeMind Power"
          class="site-header-logo h-12 w-auto max-lg:h-10"
        />
      </a>

      <!-- Navegación Desktop - centrada (misma que primera hoja) -->
      <nav class="absolute left-1/2 -translate-x-1/2 hidden sm:block" aria-label="Navegación principal">
        <div class="flex flex-nowrap items-center justify-center gap-9 max-lg:gap-6">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                'nav-link text-white no-underline whitespace-nowrap text-[17px] max-lg:text-[15px] transition-opacity hover:opacity-90',
                item.isActive ? 'font-black' : 'font-normal'
              ]}
            >
              <span data-i18n={item.key}>{item.label}</span>
            </a>
          ))}
        </div>
      </nav>

      <!-- Acciones: selector idioma, Registro, Login (misma barra que primera hoja + idiomas) -->
      <div class="hidden sm:flex items-center gap-3">
        <LanguageSwitcher />
        <a href="/registro" class="header-btn header-btn-registro" data-i18n="header.register">Registro</a>
        <a href="/login" class="header-btn header-btn-login" data-i18n="header.login">Login</a>
      </div>

      <div class="sm:hidden flex flex-col w-full">
      <div class="flex items-center justify-between w-full">
        <a href="/" class="flex items-center gap-2 no-underline">
          <img
            src="/images/logos/Logo_Be-Mind%20night.svg"
            alt="BeMind Power"
            class="h-8 w-auto"
          />
        </a>
        
        <button
          id="hamburger-btn"
          class="hamburger-button flex items-center justify-center w-10 h-10 rounded-xl text-white bg-white/10 border border-white/20 transition-all hover:bg-white/20 backdrop-blur-sm"
          type="button"
          aria-label="Abrir menú"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <!-- Icono hamburguesa (3 líneas) -->
          <svg 
            class="hamburger-icon w-5 h-5 transition-transform duration-300" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
          <!-- Icono X (cerrar) -->
          <svg 
            class="close-icon w-5 h-5 hidden transition-transform duration-300" 
            fill="none" 
            stroke="currentColor" 
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path 
              stroke-linecap="round" 
              stroke-linejoin="round" 
              stroke-width="2" 
              d="M6 18L18 6M6 6l12 12"
            />
          </svg>
        </button>
      </div>

      <!-- Menú desplegable móvil (mismo estilo que primera hoja: glass oscuro) -->
      <div
        id="mobile-menu"
        data-open="false"
        class="mobile-menu-panel w-full mt-3 origin-top
               flex flex-col items-center justify-center rounded-2xl border border-white/10 bg-black/80 backdrop-blur-xl px-4 py-4
               opacity-0 translate-y-[-8px] scale-[0.98] pointer-events-none transition-all duration-300 ease-out
               max-h-0 overflow-hidden"
      >
        <nav class="w-full" aria-label="Mobile">
          <div class="flex flex-col items-center justify-center gap-2 text-center">
            {navItems.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'mobile-menu-item text-white text-[15px] py-2.5 px-4 rounded-xl hover:bg-white/10 transition-colors w-full text-center no-underline',
                  item.isActive ? 'font-bold' : 'font-normal'
                ]}
              >
                <span data-i18n={item.key}>{item.label}</span>
              </a>
            ))}
          </div>
        </nav>

        <div class="w-full flex flex-col gap-2 mt-2 sm:hidden">
          <a href="/registro" class="header-btn header-btn-registro text-center py-3 rounded-full text-[14px] font-semibold" data-i18n="header.register">Registro</a>
          <a href="/login" class="header-btn header-btn-login text-center py-3 rounded-full text-[14px] font-semibold" data-i18n="header.login">Login</a>
        </div>

        <div class="w-full h-px bg-white/10 my-3"></div>

        <!-- Selector de idiomas inline para móvil -->
        <div class="language-grid w-full">
          <p class="text-white/50 text-[11px] text-center mb-2" data-i18n="menu.selectLanguage">Seleccionar idioma</p>
          <div class="flex items-center justify-center gap-3">
            <button type="button" class="mobile-lang-btn" data-lang="en" aria-label="English">
              <span class="text-xl">🇺🇸</span>
            </button>
            <button type="button" class="mobile-lang-btn" data-lang="es" aria-label="Español">
              <span class="text-xl">🇪🇸</span>
            </button>
            <button type="button" class="mobile-lang-btn" data-lang="pt" aria-label="Português">
              <span class="text-xl">🇧🇷</span>
            </button>
            <button type="button" class="mobile-lang-btn" data-lang="zh" aria-label="中文">
              <span class="text-xl">🇨🇳</span>
            </button>
            <button type="button" class="mobile-lang-btn" data-lang="ar" aria-label="العربية">
              <span class="text-xl">🇸🇦</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
  </div>
</header>

<style>
  /* Navbar con glassmorphism */
  .header-glass-wrap {
    width: 100%;
  }

  /* Barra única: colores de la primera hoja (inicio) + efecto glass */
  .header-glass {
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.15);
    box-shadow:
      0 4px 30px rgba(0, 0, 0, 0.1),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .nav-link {
    text-decoration: none;
  }

  /* Estado abierto del menú */
  .mobile-menu-panel[data-open='true'] {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
    max-height: 320px;
    overflow: hidden;
  }

  /* Alternar iconos del hamburger */
  .hamburger-button[aria-expanded='true'] .hamburger-icon {
    display: none;
  }

  .hamburger-button[aria-expanded='true'] .close-icon {
    display: block;
  }

  /* Botones de idioma en móvil con glass */
  .mobile-lang-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    backdrop-filter: blur(8px);
  }

  .mobile-lang-btn:active {
    background: rgba(255, 255, 255, 0.15);
    transform: scale(0.95);
  }

  .mobile-lang-btn[aria-selected="true"] {
    background: rgba(139, 92, 246, 0.3);
    border-color: rgba(139, 92, 246, 0.5);
    box-shadow: 0 0 20px rgba(139, 92, 246, 0.2);
  }

  /* Botones Registro y Login - según Figma: pill shape, altura ~42px */
  .header-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 42px;
    padding: 0 24px;
    border-radius: 9999px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease, filter 0.2s ease;
    white-space: nowrap;
  }

  .header-btn:hover {
    transform: scale(1.03);
    filter: brightness(1.1);
  }

  .header-btn-registro {
    background: #a713bf;
    color: #fff;
    border: none;
    box-shadow: 0 4px 16px rgba(167, 19, 191, 0.45);
  }

  .header-btn-registro:hover {
    box-shadow: 0 6px 24px rgba(167, 19, 191, 0.55);
  }

  .header-btn-login {
    background: #1929ff;
    color: #fff;
    border: none;
    box-shadow: 0 4px 16px rgba(25, 41, 255, 0.45);
  }

  .header-btn-login:hover {
    box-shadow: 0 6px 24px rgba(25, 41, 255, 0.55);
  }

  /* Tablet: menos espacio para que no se apriete */
  @media (max-width: 900px) {
    .header-glass {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .nav-link {
      font-size: 14px;
    }
  }

  /* Móvil: tap targets y menú */
  @media (max-width: 640px) {
    .site-header {
      padding-left: 1rem;
      padding-right: 1rem;
      top: 1rem;
    }

    .header-glass {
      padding-left: 0.65rem;
      padding-right: 0.65rem;
      min-height: 48px;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
    }

    .hamburger-button {
      min-width: 40px;
      min-height: 40px;
      width: 40px;
      height: 40px;
    }

    .site-header-logo {
      height: 1.75rem !important;
    }

    .mobile-menu-panel[data-open='true'] {
      max-height: 85vh;
      overflow-y: auto;
    }

    .mobile-menu-item {
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .header-btn {
      min-height: 44px;
      padding: 0 1.25rem;
      font-size: 14px;
    }
  }

  /* Para pantallas muy pequeñas */
  @media (max-width: 380px) {
    .header-glass {
      padding-left: 0.5rem;
      padding-right: 0.5rem;
      min-height: 46px;
    }

    .site-header-logo {
      height: 1.65rem !important;
    }

    .hamburger-button {
      min-width: 38px;
      min-height: 38px;
      width: 38px;
      height: 38px;
    }
  }
</style>

<script>
  import { $menuOpen, toggleMenu, closeMenu } from '../stores';
  import { $lang, setLanguage, type Lang } from '../stores';

  // Inicializar menú cuando el DOM esté listo
  function initMobileMenu(): void {
    const hamburgerBtn = document.getElementById('hamburger-btn');
    const mobileMenu = document.getElementById('mobile-menu');

    if (!hamburgerBtn || !mobileMenu) return;
    
    // Evitar inicialización duplicada
    if (hamburgerBtn.hasAttribute('data-initialized')) return;
    hamburgerBtn.setAttribute('data-initialized', 'true');

    // Suscribirse a cambios del store
    $menuOpen.subscribe((isOpen) => {
      mobileMenu.setAttribute('data-open', String(isOpen));
      hamburgerBtn.setAttribute('aria-expanded', String(isOpen));
    });

    // Click en hamburguesa
    hamburgerBtn.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      toggleMenu();
    });

    // Cerrar menú al hacer click en un enlace
    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu());
    });

    // Cerrar menú al hacer click fuera
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (!hamburgerBtn.contains(target) && !mobileMenu.contains(target)) {
        closeMenu();
      }
    });

    // Cerrar con tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && $menuOpen.get()) {
        closeMenu();
      }
    });

    // Inicializar botones de idioma en móvil
    initMobileLangButtons();
  }

  function initMobileLangButtons(): void {
    const langButtons = document.querySelectorAll<HTMLButtonElement>('.mobile-lang-btn');
    
    if (langButtons.length === 0) return;
    
    // Evitar inicialización duplicada
    const firstBtn = langButtons[0];
    if (firstBtn.hasAttribute('data-initialized')) return;
    firstBtn.setAttribute('data-initialized', 'true');
    
    // Actualizar estado visual de los botones
    const updateLangButtons = (currentLang: Lang): void => {
      langButtons.forEach((btn) => {
        const btnLang = btn.getAttribute('data-lang');
        btn.setAttribute('aria-selected', String(btnLang === currentLang));
      });
    };

    // Inicializar con el idioma actual
    updateLangButtons($lang.get());

    // Suscribirse a cambios de idioma
    $lang.subscribe(updateLangButtons);

    // Agregar click handlers a cada botón
    langButtons.forEach((btn) => {
      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();
        const lang = this.getAttribute('data-lang') as Lang;
        console.log('Language button clicked:', lang);
        if (lang) {
          setLanguage(lang);
        }
      });
    });
  }

  // Ejecutar cuando el DOM esté listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileMenu);
  } else {
    initMobileMenu();
  }

  // También para View Transitions de Astro
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
