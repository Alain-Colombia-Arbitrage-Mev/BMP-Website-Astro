---
// Página chat: compuesta por componentes pequeños e inspeccionables por separado.
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
---

<Layout title="BeMind Power - Chat" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva." bodyClass="chat-page">
  <div class="chat-page-wrap relative min-h-[100dvh] w-full">
    <HomeHeader />
    
    <!-- Layout Desktop: usa HomeHero normal, inicia en Chat (index 0) -->
    <div class="chat-desktop-layout">
      <HomeHero videoSrc="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4">
        <FeatureSlider initialIndex={0} />
      </HomeHero>
    </div>

    <!-- Layout Mobile: estructura separada para mejor control -->
    <div class="chat-mobile-layout">
      <!-- Video de fondo -->
      <div class="chat-mobile-bg">
        <video
          class="chat-mobile-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4" type="video/mp4" />
        </video>
        <div class="chat-mobile-overlay"></div>
        <div class="chat-mobile-glow"></div>
      </div>

      <!-- Contenido superior: título + botones -->
      <div class="chat-mobile-content">
        <div class="chat-mobile-title">
          <h1 class="chat-title">
            <span class="chat-title-line1" data-i18n="home.hero.titleLine1">Todo empieza</span>
            <span class="chat-title-line2" data-i18n="home.hero.titleLine2">con una conversación</span>
          </h1>
          <p class="chat-subtitle" data-i18n="home.hero.subtitle">Y desde ahí: paga, vende, sana o escucha música. Sin salir del chat.</p>
        </div>

        <div class="chat-mobile-buttons">
          <a href="#slider" class="chat-cta" data-i18n="home.hero.cta">Ver Más</a>
          <div class="chat-badges">
            <a href="#" class="chat-store-btn" aria-label="Download on the App Store">
              <img src="/images/app-store-badge.svg" alt="Download on the App Store" />
            </a>
            <a href="#" class="chat-store-btn" aria-label="Get it on Google Play">
              <img src="/images/google-play-badge.svg" alt="Get it on Google Play" />
            </a>
          </div>
        </div>
      </div>

      <!-- Slider abajo, inicia en Chat (index 0) -->
      <div class="chat-mobile-slider">
        <FeatureSlider initialIndex={0} />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body.chat-page {
    background: #000000;
    overflow-x: hidden;
  }

  /* Desktop: mostrar layout normal, ocultar mobile */
  .chat-desktop-layout {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chat-mobile-layout {
    display: none;
  }

  /* Mobile: ocultar desktop, mostrar mobile */
  @media (max-width: 768px) {
    .chat-desktop-layout {
      display: none;
    }

    .chat-mobile-layout {
      display: flex;
      flex-direction: column;
      position: relative;
      width: 100%;
      height: 100dvh;
      height: 100vh; /* Fallback */
      overflow: hidden;
    }

    /* Video de fondo */
    .chat-mobile-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    .chat-mobile-video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      object-fit: cover;
      object-position: center;
      opacity: 0.85;
    }

    .chat-mobile-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      z-index: 1;
    }

    .chat-mobile-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80vw;
      height: 80vw;
      background: radial-gradient(
        circle,
        rgba(40, 54, 233, 0.89) 0%,
        rgba(40, 54, 233, 0.5) 40%,
        transparent 70%
      );
      filter: blur(198px);
      z-index: 2;
    }

    /* Contenido superior: contiene título + botones */
    .chat-mobile-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: min(100px, 13vh);
      padding-bottom: 0.75rem;
      flex-shrink: 0;
    }

    /* Título */
    .chat-mobile-title {
      text-align: center;
      padding: 0 5% 0.5rem 5%;
    }

    .chat-title {
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 0 0 0.4rem 0;
      line-height: 1.15;
    }

    .chat-title-line1 {
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-size: clamp(32px, 9vw, 48px);
      font-weight: 900;
      letter-spacing: 0.01em;
    }

    .chat-title-line2 {
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(18px, 5vw, 28px);
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .chat-subtitle {
      color: #fff;
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(13px, 3.5vw, 16px);
      font-weight: 400;
      line-height: 1.35;
      margin: 0;
      max-width: 90%;
      margin-left: auto;
      margin-right: auto;
    }

    /* Botones */
    .chat-mobile-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
      padding: 0 5%;
    }

    .chat-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: clamp(48px, 7vh, 56px);
      padding: 0 2rem;
      width: min(280px, 75vw);
      background: #1929ff;
      color: #fff;
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-weight: 900;
      font-size: clamp(14px, 4vw, 16px);
      letter-spacing: 0.02em;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-cta:hover,
    .chat-cta:active {
      transform: scale(1.02);
      box-shadow: 0 4px 24px rgba(25, 41, 255, 0.5);
    }

    .chat-badges {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .chat-store-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(240px, 70vw);
      height: clamp(44px, 6.5vh, 52px);
      padding: 0 16px;
      background: rgba(0, 0, 0, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 50px;
      box-shadow: 0 4px 14px rgba(55, 27, 190, 0.25), 0 -4px 14px rgba(25, 41, 255, 0.2);
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-store-btn:hover,
    .chat-store-btn:active {
      transform: scale(1.02);
      box-shadow: 0 6px 20px rgba(55, 27, 190, 0.35);
    }

    .chat-store-btn img {
      height: clamp(22px, 3.5vh, 28px);
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    /* Slider - ocupa el resto del espacio inferior */
    .chat-mobile-slider {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 5;
      height: 42vh;
      min-height: 280px;
      max-height: 400px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 2%;
    }

    .chat-mobile-slider .feature-slider {
      width: 100%;
      height: 100%;
      min-height: 260px;
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
      min-height: 240px;
    }

    .chat-mobile-slider .slider-wrapper {
      padding: 0;
      height: 100%;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.35rem;
    }
  }

  /* Tablets pequeñas / móviles grandes (601-768px) - ej: iPad Mini landscape, tablets */
  @media (max-width: 768px) and (min-width: 601px) {
    .chat-mobile-content {
      padding-top: min(110px, 12vh);
    }

    .chat-title-line1 {
      font-size: clamp(36px, 7vw, 48px);
    }

    .chat-title-line2 {
      font-size: clamp(20px, 4vw, 28px);
    }

    .chat-subtitle {
      font-size: clamp(14px, 2.5vw, 17px);
    }

    .chat-cta {
      width: min(300px, 60vw);
      min-height: 54px;
    }

    .chat-store-btn {
      width: min(260px, 55vw);
      height: 50px;
    }

    .chat-mobile-slider {
      height: 45vh;
      min-height: 320px;
      max-height: 420px;
    }
  }

  /* Móviles medianos (481-600px) - ej: iPhone Plus, Pixel XL */
  @media (max-width: 600px) and (min-width: 481px) {
    .chat-mobile-content {
      padding-top: min(95px, 12vh);
      padding-bottom: 0.6rem;
    }

    .chat-title-line1 {
      font-size: clamp(30px, 8vw, 42px);
    }

    .chat-title-line2 {
      font-size: clamp(18px, 4.5vw, 26px);
    }

    .chat-subtitle {
      font-size: clamp(13px, 3vw, 15px);
    }

    .chat-mobile-buttons {
      gap: 0.35rem;
    }

    .chat-cta {
      width: min(270px, 72vw);
      min-height: 50px;
    }

    .chat-store-btn {
      width: min(230px, 65vw);
      height: 48px;
    }

    .chat-mobile-slider {
      height: 40vh;
      min-height: 290px;
      max-height: 360px;
    }
  }

  /* Móviles estándar (415-480px) - ej: iPhone 14, Pixel 7 */
  @media (max-width: 480px) and (min-width: 415px) {
    .chat-mobile-content {
      padding-top: min(90px, 12vh);
      padding-bottom: 0.5rem;
    }

    .chat-mobile-title {
      padding-bottom: 0.4rem;
    }

    .chat-title-line1 {
      font-size: clamp(28px, 8vw, 38px);
    }

    .chat-title-line2 {
      font-size: clamp(17px, 4.5vw, 24px);
    }

    .chat-subtitle {
      font-size: clamp(12px, 3.2vw, 14px);
    }

    .chat-mobile-buttons {
      gap: 0.3rem;
    }

    .chat-cta {
      width: min(260px, 70vw);
      min-height: 48px;
      font-size: 15px;
    }

    .chat-store-btn {
      width: min(220px, 60vw);
      height: 46px;
    }

    .chat-store-btn img {
      height: 24px;
    }

    .chat-mobile-slider {
      height: 42vh;
      min-height: 270px;
      max-height: 340px;
    }

    .chat-mobile-slider .slider-container {
      min-height: 230px;
    }
  }

  /* Móviles pequeños (381-414px) - ej: iPhone 13 Mini, SE */
  @media (max-width: 414px) and (min-width: 381px) {
    .chat-mobile-content {
      padding-top: min(88px, 11vh);
      padding-bottom: 0.4rem;
    }

    .chat-mobile-title {
      padding-bottom: 0.35rem;
    }

    .chat-title {
      margin-bottom: 0.3rem;
    }

    .chat-title-line1 {
      font-size: clamp(26px, 7.5vw, 34px);
    }

    .chat-title-line2 {
      font-size: clamp(16px, 4.2vw, 22px);
    }

    .chat-subtitle {
      font-size: clamp(11px, 3vw, 13px);
      max-width: 88%;
    }

    .chat-mobile-buttons {
      gap: 0.25rem;
    }

    .chat-cta {
      width: min(250px, 68vw);
      min-height: 46px;
      font-size: 14px;
    }

    .chat-store-btn {
      width: min(210px, 58vw);
      height: 44px;
    }

    .chat-store-btn img {
      height: 22px;
    }

    .chat-mobile-slider {
      height: 44vh;
      min-height: 260px;
      max-height: 320px;
    }

    .chat-mobile-slider .slider-container {
      min-height: 220px;
    }
  }

  /* Móviles muy pequeños (321-380px) - ej: iPhone SE 1gen, Galaxy S mini */
  @media (max-width: 380px) and (min-width: 321px) {
    .chat-mobile-content {
      padding-top: min(85px, 11vh);
      padding-bottom: 0.35rem;
    }

    .chat-mobile-title {
      padding-bottom: 0.3rem;
    }

    .chat-title {
      margin-bottom: 0.25rem;
    }

    .chat-title-line1 {
      font-size: clamp(24px, 7vw, 32px);
    }

    .chat-title-line2 {
      font-size: clamp(15px, 4vw, 20px);
    }

    .chat-subtitle {
      font-size: 11px;
      max-width: 85%;
      line-height: 1.3;
    }

    .chat-mobile-buttons {
      gap: 0.2rem;
    }

    .chat-cta {
      width: min(230px, 65vw);
      min-height: 44px;
      font-size: 13px;
      padding: 0 1.5rem;
    }

    .chat-store-btn {
      width: min(195px, 55vw);
      height: 42px;
      padding: 0 12px;
    }

    .chat-store-btn img {
      height: 20px;
    }

    .chat-mobile-slider {
      height: 45vh;
      min-height: 250px;
      max-height: 300px;
    }

    .chat-mobile-slider .slider-container {
      min-height: 210px;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.25rem;
    }
  }

  /* Móviles ultra pequeños (<=320px) - ej: iPhone 5, dispositivos antiguos */
  @media (max-width: 320px) {
    .chat-mobile-content {
      padding-top: min(80px, 10vh);
      padding-bottom: 0.25rem;
    }

    .chat-mobile-title {
      padding: 0 4% 0.25rem 4%;
    }

    .chat-title {
      margin-bottom: 0.2rem;
    }

    .chat-title-line1 {
      font-size: 22px;
    }

    .chat-title-line2 {
      font-size: 14px;
    }

    .chat-subtitle {
      font-size: 10px;
      max-width: 82%;
      line-height: 1.25;
    }

    .chat-mobile-buttons {
      gap: 0.15rem;
      padding: 0 4%;
    }

    .chat-cta {
      width: min(210px, 70vw);
      min-height: 40px;
      font-size: 12px;
      padding: 0 1.25rem;
    }

    .chat-store-btn {
      width: min(180px, 60vw);
      height: 38px;
      padding: 0 10px;
    }

    .chat-store-btn img {
      height: 18px;
    }

    .chat-mobile-slider {
      height: 48vh;
      min-height: 230px;
      max-height: 280px;
    }

    .chat-mobile-slider .slider-container {
      min-height: 190px;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.2rem;
    }

    .chat-mobile-slider .nav-btn {
      width: 32px;
      height: 32px;
    }
  }

  /* Landscape mode para móviles */
  @media (max-width: 768px) and (max-height: 500px) and (orientation: landscape) {
    .chat-mobile-content {
      padding-top: 70px;
      padding-bottom: 0.25rem;
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
    }

    .chat-mobile-title {
      flex: 1;
      min-width: 200px;
      padding: 0 2%;
    }

    .chat-mobile-buttons {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }

    .chat-badges {
      flex-direction: row;
      gap: 0.5rem;
    }

    .chat-mobile-slider {
      height: 55vh;
      min-height: 180px;
      max-height: 250px;
    }

    .chat-mobile-slider .slider-container {
      min-height: 150px;
    }
  }
</style>

<script>
  // Optimizar reproducción de video en mobile
  function initChatMobileVideo(): void {
    const video = document.querySelector('.chat-mobile-video') as HTMLVideoElement;
    if (!video) return;

    const playVideo = () => {
      video.play().catch(() => {
        document.addEventListener('touchstart', () => {
          video.play();
        }, { once: true });
      });
    };

    if (video.readyState >= 2) {
      playVideo();
    } else {
      video.addEventListener('loadeddata', playVideo, { once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatMobileVideo);
  } else {
    initChatMobileVideo();
  }
</script>
