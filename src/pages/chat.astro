---
// Página chat: compuesta por componentes pequeños e inspeccionables por separado.
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
---

<Layout title="BeMind Power - Chat" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva." bodyClass="chat-page">
  <div class="chat-page-wrap relative min-h-[100dvh] w-full">
    <HomeHeader />
    
    <!-- Layout Desktop: usa HomeHero normal, inicia en Chat (index 0) -->
    <div class="chat-desktop-layout">
      <HomeHero videoSrc="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4">
        <FeatureSlider initialIndex={0} />
      </HomeHero>
    </div>

    <!-- Layout Mobile: estructura separada para mejor control -->
    <div class="chat-mobile-layout">
      <!-- Video de fondo -->
      <div class="chat-mobile-bg">
        <video
          class="chat-mobile-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4" type="video/mp4" />
        </video>
        <div class="chat-mobile-overlay"></div>
        <div class="chat-mobile-glow"></div>
      </div>

      <!-- Contenido superior: título + botones -->
      <div class="chat-mobile-content">
        <div class="chat-mobile-title">
          <h1 class="chat-title">
            <span class="chat-title-line1" data-i18n="home.hero.titleLine1">Todo empieza</span>
            <span class="chat-title-line2" data-i18n="home.hero.titleLine2">con una conversación</span>
          </h1>
          <p class="chat-subtitle" data-i18n="home.hero.subtitle">Y desde ahí: paga, vende, sana o escucha música. Sin salir del chat.</p>
        </div>

        <div class="chat-mobile-buttons">
          <a href="#slider" class="chat-cta" data-i18n="home.hero.cta">Ver Más</a>
          <div class="chat-badges">
            <a href="#" class="chat-store-btn" aria-label="Download on the App Store">
              <img src="/images/app-store-badge.svg" alt="Download on the App Store" />
            </a>
            <a href="#" class="chat-store-btn" aria-label="Get it on Google Play">
              <img src="/images/google-play-badge.svg" alt="Get it on Google Play" />
            </a>
          </div>
        </div>
      </div>

      <!-- Slider abajo, inicia en Chat (index 0) -->
      <div class="chat-mobile-slider">
        <FeatureSlider initialIndex={0} />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body.chat-page {
    background: #000000;
    overflow-x: hidden;
  }

  /* Desktop: mostrar layout normal, ocultar mobile */
  .chat-desktop-layout {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chat-mobile-layout {
    display: none;
  }

  /* Mobile: ocultar desktop, mostrar mobile */
  @media (max-width: 768px) {
    body.chat-page {
      /* Evita scroll por 1-2px de rounding en móviles */
      overflow: hidden;
      overscroll-behavior: none;
    }

    .chat-desktop-layout {
      display: none;
    }

    .chat-mobile-layout {
      display: flex;
      flex-direction: column;
      position: relative;
      width: 100%;
      height: 100dvh;
      height: 100vh;
      overflow: hidden;
      box-sizing: border-box;
    }

    /* Video de fondo */
    .chat-mobile-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    .chat-mobile-video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      object-fit: cover;
      object-position: center;
      opacity: 0.85;
    }

    .chat-mobile-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      z-index: 1;
    }

    .chat-mobile-glow {
      position: absolute;
      top: 40%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80vw;
      height: 80vw;
      background: radial-gradient(
        circle,
        rgba(40, 54, 233, 0.89) 0%,
        rgba(40, 54, 233, 0.5) 40%,
        transparent 70%
      );
      filter: blur(198px);
      z-index: 2;
    }

    /* Contenido: título + botones */
    .chat-mobile-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      /* Distribuir sin pegarlo arriba: centrado en el espacio disponible */
      justify-content: center;
      padding: calc(88px + env(safe-area-inset-top)) 5% 0.6rem 5%;
      gap: clamp(0.6rem, 1.6vh, 1rem);
      overflow: visible;
      flex: 1 1 auto;
      min-height: 0;
    }

    /* Título */
    .chat-mobile-title {
      text-align: center;
      width: 100%;
    }

    .chat-title {
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 0 0 0.65rem 0;
      line-height: 1.1;
    }

    .chat-title-line1 {
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-size: clamp(28px, 7.5vw, 40px);
      font-weight: 900;
      letter-spacing: 0.01em;
    }

    .chat-title-line2 {
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(16px, 4.2vw, 24px);
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .chat-subtitle {
      color: #fff;
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(11px, 3vw, 14px);
      font-weight: 400;
      line-height: 1.3;
      margin: 0 0 0.25rem 0;
      max-width: 92%;
      margin-left: auto;
      margin-right: auto;
    }

    /* Botones */
    .chat-mobile-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      /* Separación extra desde el texto para mejor distribución */
      margin-top: clamp(0.6rem, 2.2vh, 1.35rem);
      gap: 0.5rem; /* Aumentado el gap */
      width: 100%;
    }

    .chat-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: clamp(44px, 6vh, 50px);
      padding: 0 2rem;
      width: min(280px, 72vw); /* Más ancho */
      background: #1929ff;
      color: #fff;
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-weight: 900;
      font-size: clamp(14px, 3.8vw, 16px);
      letter-spacing: 0.02em;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-cta:hover,
    .chat-cta:active {
      transform: scale(1.02);
      box-shadow: 0 4px 24px rgba(25, 41, 255, 0.5);
    }

    .chat-badges {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem; /* Aumentado el gap */
    }

    .chat-store-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(260px, 68vw); /* Más ancho */
      height: clamp(44px, 6.2vh, 52px);
      padding: 0 18px;
      background: rgba(0, 0, 0, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 50px;
      box-shadow: 0 4px 14px rgba(55, 27, 190, 0.25), 0 -4px 14px rgba(25, 41, 255, 0.2);
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-store-btn:hover,
    .chat-store-btn:active {
      transform: scale(1.02);
      box-shadow: 0 6px 20px rgba(55, 27, 190, 0.35);
    }

    .chat-store-btn img {
      height: clamp(26px, 4.4vh, 35px);
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    /* Slider - parte inferior */
    .chat-mobile-slider {
      position: relative;
      z-index: 5;
      width: 100%;
      /* El slider ocupa el espacio sobrante para evitar vacío inferior */
      flex: 0 0 auto;
      height: clamp(240px, 34vh, 330px);
      max-height: 40vh;
      display: flex;
      align-items: center;
      justify-content: center;
      /* Más “aire” inferior y leve separación superior para que no quede pegado */
      padding: clamp(6px, 1vh, 12px) 2% calc(22px + env(safe-area-inset-bottom)) 2%;
      margin-top: auto;
    }

    .chat-mobile-slider .feature-slider {
      width: 100%;
      height: 100%;
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
      min-height: 0;
    }

    .chat-mobile-slider .slider-wrapper {
      padding: 0;
      height: 100%;
    }

    /* Subir un poco la tarjeta activa dentro del área del slider (mejor composición) */
    .chat-mobile-slider .slider-item {
      top: 46% !important;
    }

    /* Ocultar flechas de navegación en móvil para ganar espacio */
    .chat-mobile-slider .slider-nav {
      display: none;
    }
  }

  /* Tablets pequeñas / móviles grandes (601-768px) */
  @media (max-width: 768px) and (min-width: 601px) {
    .chat-mobile-content {
      /* En iPad vertical (768px) el header ya es el layout "desktop" (>=640),
         así que necesitamos más espacio superior para que no se monte. */
      padding: calc(104px + env(safe-area-inset-top)) 5% 0.6rem 5%;
      gap: clamp(0.7rem, 1.2vh, 1rem);
    }

    .chat-title {
      margin-bottom: 0.8rem;
    }

    .chat-title-line1 {
      font-size: clamp(34px, 5.5vw, 44px);
    }

    .chat-title-line2 {
      font-size: clamp(19px, 3.2vw, 26px);
    }

    .chat-subtitle {
      font-size: clamp(13px, 2vw, 16px);
      margin-bottom: 0.5rem;
    }

    .chat-cta {
      width: min(300px, 55vw);
      height: 54px;
      font-size: 16px;
    }

    .chat-store-btn {
      width: min(280px, 52vw);
      height: 56px;
    }

    .chat-store-btn img {
      height: 35px;
    }

    .chat-mobile-slider {
      height: clamp(280px, 36vh, 380px);
      min-height: 280px;
      max-height: none;
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* iPad (portrait) — centrar el layout móvil sin afectar mobile/desktop */
  @media (max-width: 768px) and (min-width: 744px) {
    .chat-mobile-layout {
      justify-content: center;
      /* Reservar espacio real del navbar (hamburger) en iPad, sin empujar el contenido fuera del centro */
      padding-top: calc(88px + env(safe-area-inset-top));
      padding-bottom: calc(16px + env(safe-area-inset-bottom));
    }

    .chat-mobile-content {
      flex: 0 0 auto;
      padding-top: 0;
      padding-bottom: 0.85rem;
    }

    .chat-mobile-slider {
      margin-top: 0;
      height: clamp(320px, 34vh, 420px);
      max-height: 40vh;
      /* Evitar que el padding interno rompa el centrado */
      padding-top: 0;
      padding-bottom: 0;
    }
  }

  /* Móviles medianos (481-600px) */
  @media (max-width: 600px) and (min-width: 481px) {
    .chat-mobile-content {
      padding: calc(70px + env(safe-area-inset-top)) 5% 0.45rem 5%;
      gap: clamp(0.6rem, 1.35vh, 0.95rem);
    }

    .chat-title {
      margin-bottom: 0.7rem;
    }

    .chat-title-line1 {
      font-size: clamp(30px, 6.5vw, 38px);
    }

    .chat-title-line2 {
      font-size: clamp(17px, 3.8vw, 23px);
    }

    .chat-subtitle {
      margin-bottom: 0.4rem;
    }

    .chat-cta {
      width: min(290px, 62vw);
      height: 52px;
      font-size: 15px;
    }

    .chat-store-btn {
      width: min(270px, 58vw);
      height: 54px;
    }

    .chat-store-btn img {
      height: 35px;
    }

    .chat-mobile-slider {
      min-height: 250px;
      max-height: none;
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* iPhone 14 Pro Max, Pixel 7 (415-480px) */
  @media (max-width: 480px) and (min-width: 415px) {
    .chat-mobile-content {
      padding: calc(68px + env(safe-area-inset-top)) 5% 0.4rem 5%;
      gap: clamp(0.55rem, 1.2vh, 0.85rem);
    }

    .chat-title {
      margin-bottom: 0.6rem;
    }

    .chat-title-line1 {
      font-size: 34px;
    }

    .chat-title-line2 {
      font-size: 19px;
    }

    .chat-subtitle {
      font-size: 13px;
      margin-bottom: 0.4rem;
    }

    .chat-mobile-buttons {
      gap: 0.5rem;
    }

    .chat-cta {
      width: 290px;
      height: 54px;
      font-size: 16px;
    }

    .chat-store-btn {
      width: 270px;
      height: 54px;
    }

    .chat-store-btn img {
      height: 35px;
    }

    .chat-mobile-slider {
      min-height: 250px;
      max-height: none;
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* iPhone 11 Pro / 12 Mini / 13 Mini (375-414px) */
  @media (max-width: 414px) and (min-width: 375px) {
    .chat-mobile-content {
      padding: calc(68px + env(safe-area-inset-top)) 5% 0.35rem 5%;
      gap: clamp(0.55rem, 1.2vh, 0.85rem);
    }

    .chat-title {
      margin-bottom: 0.5rem;
    }

    .chat-title-line1 {
      font-size: 32px;
    }

    .chat-title-line2 {
      font-size: 18px;
    }

    .chat-subtitle {
      font-size: 12px;
      max-width: 90%;
      margin-bottom: 0.3rem;
    }

    .chat-mobile-buttons {
      gap: 0.5rem;
    }

    .chat-cta {
      width: 280px;
      height: 52px;
      font-size: 15px;
    }

    .chat-store-btn {
      width: 260px;
      height: 52px;
    }

    .chat-store-btn img {
      height: 32px;
    }

    .chat-mobile-slider {
      min-height: 245px;
      max-height: none;
      padding-bottom: calc(10px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* Móviles muy pequeños (321-374px) - iPhone SE */
  @media (max-width: 374px) and (min-width: 321px) {
    .chat-mobile-content {
      padding: calc(66px + env(safe-area-inset-top)) 4% 0.3rem 4%;
      gap: clamp(0.5rem, 1.1vh, 0.75rem);
    }

    .chat-title {
      margin-bottom: 0.4rem;
    }

    .chat-title-line1 {
      font-size: 26px;
    }

    .chat-title-line2 {
      font-size: 15px;
    }

    .chat-subtitle {
      font-size: 11px;
      max-width: 90%;
      line-height: 1.3;
      margin-bottom: 0.3rem;
    }

    .chat-mobile-buttons {
      gap: 0.4rem;
    }

    .chat-cta {
      width: 240px;
      height: 48px;
      font-size: 14px;
      padding: 0 1.5rem;
    }

    .chat-store-btn {
      width: 220px;
      height: 48px;
      padding: 0 14px;
    }

    .chat-store-btn img {
      height: 28px;
    }

    .chat-mobile-slider {
      min-height: 235px;
      max-height: none;
      padding-bottom: calc(10px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* Móviles ultra pequeños (<=320px) - iPhone 5 */
  @media (max-width: 320px) {
    .chat-mobile-content {
      padding: calc(64px + env(safe-area-inset-top)) 3% 0.25rem 3%;
      gap: clamp(0.45rem, 1vh, 0.7rem);
    }

    .chat-title {
      margin-bottom: 0.3rem;
    }

    .chat-title-line1 {
      font-size: 24px;
    }

    .chat-title-line2 {
      font-size: 14px;
    }

    .chat-subtitle {
      font-size: 10px;
      max-width: 88%;
      line-height: 1.25;
      margin-bottom: 0.2rem;
    }

    .chat-mobile-buttons {
      gap: 0.35rem;
    }

    .chat-cta {
      width: 200px;
      height: 44px;
      font-size: 13px;
      padding: 0 1.25rem;
    }

    .chat-store-btn {
      width: 185px;
      height: 44px;
      padding: 0 10px;
    }

    .chat-store-btn img {
      height: 24px;
    }

    .chat-mobile-slider {
      min-height: 220px;
      max-height: none;
      padding-bottom: calc(8px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }

  /* Ajustes por altura (portrait) para evitar overflow/scroll en móviles compactos */
  @media (max-width: 768px) and (max-height: 740px) {
    .chat-mobile-content {
      padding-top: calc(76px + env(safe-area-inset-top));
      gap: 0.6rem;
    }

    .chat-title-line1 {
      font-size: clamp(26px, 7vw, 34px);
    }

    .chat-title-line2 {
      font-size: clamp(14px, 3.8vw, 18px);
    }

    .chat-subtitle {
      font-size: 12px;
    }

    .chat-mobile-slider {
      height: clamp(220px, 33vh, 300px);
      max-height: 38vh;
      padding-bottom: calc(10px + env(safe-area-inset-bottom));
    }

    .chat-mobile-buttons {
      margin-top: 0.7rem;
    }
  }

  @media (max-width: 768px) and (max-height: 680px) {
    .chat-mobile-content {
      padding-top: calc(70px + env(safe-area-inset-top));
      gap: 0.55rem;
    }

    .chat-title {
      margin-bottom: 0.5rem;
    }

    .chat-cta {
      height: 42px;
      font-size: 14px;
    }

    .chat-store-btn {
      height: 44px;
    }

    .chat-store-btn img {
      height: 26px;
    }

    .chat-mobile-slider {
      height: clamp(200px, 32vh, 270px);
      max-height: 36vh;
    }

    .chat-mobile-buttons {
      margin-top: 0.6rem;
    }
  }

  @media (max-width: 768px) and (max-height: 610px) {
    .chat-mobile-content {
      /* En alturas muy bajas, priorizar lectura (menos "centro") */
      justify-content: flex-start;
      padding-top: calc(62px + env(safe-area-inset-top));
      gap: 0.5rem;
    }

    .chat-title-line1 {
      font-size: 24px;
    }

    .chat-title-line2 {
      font-size: 14px;
    }

    .chat-subtitle {
      font-size: 11px;
    }

    .chat-badges {
      gap: 0.35rem;
    }

    .chat-mobile-slider {
      height: clamp(170px, 30vh, 230px);
      max-height: 34vh;
      padding-bottom: calc(8px + env(safe-area-inset-bottom));
    }

    .chat-mobile-slider .slider-item {
      top: 44% !important;
    }

    .chat-mobile-buttons {
      margin-top: 0.45rem;
    }
  }

  /* Landscape mode para móviles */
  @media (max-width: 768px) and (max-height: 500px) and (orientation: landscape) {
    .chat-mobile-layout {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .chat-mobile-content {
      flex: 1;
      min-width: 50%;
      padding: 60px 2% 0.4rem 2%;
      gap: 0.25rem;
    }

    .chat-mobile-title {
      padding: 0;
    }

    .chat-title {
      margin-bottom: 0.3rem;
    }

    .chat-title-line1 {
      font-size: clamp(18px, 4.5vw, 26px);
    }

    .chat-title-line2 {
      font-size: clamp(11px, 2.5vw, 16px);
    }

    .chat-subtitle {
      font-size: 10px;
      margin-bottom: 0.15rem;
    }

    .chat-mobile-buttons {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.3rem;
    }

    .chat-badges {
      flex-direction: row;
      gap: 0.3rem;
    }

    .chat-cta {
      height: 36px;
      width: auto;
      min-width: 130px;
      font-size: 11px;
    }

    .chat-store-btn {
      height: 36px;
      width: auto;
      min-width: 125px;
    }

    .chat-store-btn img {
      height: 18px;
    }

    .chat-mobile-slider {
      width: 100%;
      height: 55vh;
      min-height: 160px;
      max-height: 220px;
    }

    .chat-mobile-slider .slider-container {
      height: 100%;
    }
  }
</style>

<script>
  // Optimizar reproducción de video en mobile
  function initChatMobileVideo(): void {
    const video = document.querySelector('.chat-mobile-video') as HTMLVideoElement;
    if (!video) return;

    const playVideo = () => {
      video.play().catch(() => {
        document.addEventListener('touchstart', () => {
          video.play();
        }, { once: true });
      });
    };

    if (video.readyState >= 2) {
      playVideo();
    } else {
      video.addEventListener('loadeddata', playVideo, { once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatMobileVideo);
  } else {
    initChatMobileVideo();
  }
</script>
