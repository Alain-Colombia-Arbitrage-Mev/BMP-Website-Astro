---
// Página chat: compuesta por componentes pequeños e inspeccionables por separado.
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import HomeHero from '../components/home/HomeHero.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
---

<Layout title="BeMind Power - Chat" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva." bodyClass="chat-page">
  <div class="chat-page-wrap relative min-h-[100dvh] w-full">
    <HomeHeader />
    
    <!-- Layout Desktop: usa HomeHero normal, inicia en Chat (index 0) -->
    <div class="chat-desktop-layout">
      <HomeHero videoSrc="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4">
        <FeatureSlider initialIndex={0} />
      </HomeHero>
    </div>

    <!-- Layout Mobile: estructura separada para mejor control -->
    <div class="chat-mobile-layout">
      <!-- Video de fondo -->
      <div class="chat-mobile-bg">
        <video
          class="chat-mobile-video"
          autoplay
          muted
          loop
          playsinline
          preload="auto"
        >
          <source src="https://pub-d1d8eb4932844ef19f969720eed8b94a.r2.dev/1%20(8).mp4" type="video/mp4" />
        </video>
        <div class="chat-mobile-overlay"></div>
        <div class="chat-mobile-glow"></div>
      </div>

      <!-- Contenido superior: título + botones -->
      <div class="chat-mobile-content">
        <div class="chat-mobile-title">
          <h1 class="chat-title">
            <span class="chat-title-line1" data-i18n="home.hero.titleLine1">Todo empieza</span>
            <span class="chat-title-line2" data-i18n="home.hero.titleLine2">con una conversación</span>
          </h1>
          <p class="chat-subtitle" data-i18n="home.hero.subtitle">Y desde ahí: paga, vende, sana o escucha música. Sin salir del chat.</p>
        </div>

        <div class="chat-mobile-buttons">
          <a href="#slider" class="chat-cta" data-i18n="home.hero.cta">Ver Más</a>
          <div class="chat-badges">
            <a href="#" class="chat-store-btn" aria-label="Download on the App Store">
              <img src="/images/app-store-badge.svg" alt="Download on the App Store" />
            </a>
            <a href="#" class="chat-store-btn" aria-label="Get it on Google Play">
              <img src="/images/google-play-badge.svg" alt="Get it on Google Play" />
            </a>
          </div>
        </div>
      </div>

      <!-- Slider abajo, inicia en Chat (index 0) -->
      <div class="chat-mobile-slider">
        <FeatureSlider initialIndex={0} />
      </div>
    </div>
  </div>
</Layout>

<style is:global>
  body.chat-page {
    background: #000000;
    overflow-x: hidden;
  }

  /* Desktop: mostrar layout normal, ocultar mobile */
  .chat-desktop-layout {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .chat-mobile-layout {
    display: none;
  }

  /* Mobile: ocultar desktop, mostrar mobile */
  @media (max-width: 768px) {
    .chat-desktop-layout {
      display: none;
    }

    .chat-mobile-layout {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
      width: 100%;
      height: 100dvh;
      height: 100vh; /* Fallback */
      overflow: hidden;
      padding-top: 80px; /* Espacio para el navbar */
      padding-bottom: 0;
      box-sizing: border-box;
    }

    /* Video de fondo */
    .chat-mobile-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
      overflow: hidden;
    }

    .chat-mobile-video {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      object-fit: cover;
      object-position: center;
      opacity: 0.85;
    }

    .chat-mobile-overlay {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, 0.3);
      z-index: 1;
    }

    .chat-mobile-glow {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80vw;
      height: 80vw;
      background: radial-gradient(
        circle,
        rgba(40, 54, 233, 0.89) 0%,
        rgba(40, 54, 233, 0.5) 40%,
        transparent 70%
      );
      filter: blur(198px);
      z-index: 2;
    }

    /* Contenido: título + botones - centrado verticalmente */
    .chat-mobile-content {
      position: relative;
      z-index: 10;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      flex: 1;
      padding: 1rem 5%;
      gap: 1rem;
    }

    /* Título */
    .chat-mobile-title {
      text-align: center;
      width: 100%;
    }

    .chat-title {
      color: #fff;
      display: flex;
      flex-direction: column;
      gap: 0;
      margin: 0 0 0.5rem 0;
      line-height: 1.15;
    }

    .chat-title-line1 {
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-size: clamp(30px, 8vw, 44px);
      font-weight: 900;
      letter-spacing: 0.01em;
    }

    .chat-title-line2 {
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(17px, 4.5vw, 26px);
      font-weight: 700;
      letter-spacing: 0.01em;
    }

    .chat-subtitle {
      color: #fff;
      font-family: 'Neometric', 'Inter', sans-serif;
      font-size: clamp(12px, 3.2vw, 15px);
      font-weight: 400;
      line-height: 1.35;
      margin: 0;
      max-width: 90%;
      margin-left: auto;
      margin-right: auto;
    }

    /* Botones */
    .chat-mobile-buttons {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      width: 100%;
    }

    .chat-cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      height: 50px;
      padding: 0 2rem;
      width: min(260px, 70vw);
      background: #1929ff;
      color: #fff;
      font-family: 'OPTIFutura-ExtraBlackCond', 'Inter', sans-serif;
      font-weight: 900;
      font-size: 15px;
      letter-spacing: 0.02em;
      border-radius: 999px;
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-cta:hover,
    .chat-cta:active {
      transform: scale(1.02);
      box-shadow: 0 4px 24px rgba(25, 41, 255, 0.5);
    }

    .chat-badges {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.4rem;
    }

    .chat-store-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: min(220px, 62vw);
      height: 46px;
      padding: 0 16px;
      background: rgba(0, 0, 0, 0.85);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 50px;
      box-shadow: 0 4px 14px rgba(55, 27, 190, 0.25), 0 -4px 14px rgba(25, 41, 255, 0.2);
      text-decoration: none;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .chat-store-btn:hover,
    .chat-store-btn:active {
      transform: scale(1.02);
      box-shadow: 0 6px 20px rgba(55, 27, 190, 0.35);
    }

    .chat-store-btn img {
      height: 24px;
      width: auto;
      max-width: 100%;
      object-fit: contain;
    }

    /* Slider - altura fija en la parte inferior */
    .chat-mobile-slider {
      position: relative;
      z-index: 5;
      width: 100%;
      height: 280px;
      min-height: 250px;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0 2%;
    }

    .chat-mobile-slider .feature-slider {
      width: 100%;
      height: 100%;
    }

    .chat-mobile-slider .slider-container {
      height: 220px;
    }

    .chat-mobile-slider .slider-wrapper {
      padding: 0;
      height: 100%;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.25rem;
    }
  }

  /* Tablets pequeñas / móviles grandes (601-768px) */
  @media (max-width: 768px) and (min-width: 601px) {
    .chat-mobile-layout {
      padding-top: 90px;
    }

    .chat-mobile-content {
      gap: 1.25rem;
    }

    .chat-title-line1 {
      font-size: clamp(34px, 6vw, 44px);
    }

    .chat-title-line2 {
      font-size: clamp(19px, 3.5vw, 26px);
    }

    .chat-subtitle {
      font-size: clamp(13px, 2.2vw, 16px);
    }

    .chat-cta {
      width: min(280px, 55vw);
      height: 54px;
      font-size: 16px;
    }

    .chat-store-btn {
      width: min(240px, 50vw);
      height: 50px;
    }

    .chat-store-btn img {
      height: 26px;
    }

    .chat-mobile-slider {
      height: 320px;
      min-height: 300px;
    }

    .chat-mobile-slider .slider-container {
      height: 260px;
    }
  }

  /* Móviles medianos (481-600px) */
  @media (max-width: 600px) and (min-width: 481px) {
    .chat-mobile-layout {
      padding-top: 85px;
    }

    .chat-mobile-content {
      gap: 1rem;
    }

    .chat-title-line1 {
      font-size: clamp(30px, 7vw, 40px);
    }

    .chat-title-line2 {
      font-size: clamp(17px, 4vw, 24px);
    }

    .chat-cta {
      width: min(260px, 60vw);
      height: 52px;
    }

    .chat-store-btn {
      width: min(225px, 55vw);
      height: 48px;
    }

    .chat-mobile-slider {
      height: 300px;
      min-height: 280px;
    }

    .chat-mobile-slider .slider-container {
      height: 240px;
    }
  }

  /* Móviles estándar (415-480px) - iPhone 14, Pixel 7 */
  @media (max-width: 480px) and (min-width: 415px) {
    .chat-mobile-layout {
      padding-top: 80px;
    }

    .chat-mobile-content {
      gap: 0.85rem;
      padding: 0.75rem 5%;
    }

    .chat-title-line1 {
      font-size: clamp(28px, 7.5vw, 36px);
    }

    .chat-title-line2 {
      font-size: clamp(16px, 4.2vw, 22px);
    }

    .chat-subtitle {
      font-size: clamp(12px, 3vw, 14px);
    }

    .chat-mobile-buttons {
      gap: 0.45rem;
    }

    .chat-cta {
      width: min(250px, 65vw);
      height: 48px;
      font-size: 14px;
    }

    .chat-store-btn {
      width: min(215px, 58vw);
      height: 44px;
    }

    .chat-store-btn img {
      height: 22px;
    }

    .chat-mobile-slider {
      height: 270px;
      min-height: 250px;
    }

    .chat-mobile-slider .slider-container {
      height: 210px;
    }
  }

  /* Móviles pequeños (381-414px) - iPhone 13 Mini, SE */
  @media (max-width: 414px) and (min-width: 381px) {
    .chat-mobile-layout {
      padding-top: 75px;
    }

    .chat-mobile-content {
      gap: 0.75rem;
      padding: 0.5rem 5%;
    }

    .chat-title {
      margin-bottom: 0.4rem;
    }

    .chat-title-line1 {
      font-size: clamp(26px, 7vw, 34px);
    }

    .chat-title-line2 {
      font-size: clamp(15px, 4vw, 20px);
    }

    .chat-subtitle {
      font-size: clamp(11px, 2.8vw, 13px);
      max-width: 88%;
    }

    .chat-mobile-buttons {
      gap: 0.4rem;
    }

    .chat-cta {
      width: min(240px, 64vw);
      height: 46px;
      font-size: 14px;
    }

    .chat-store-btn {
      width: min(205px, 56vw);
      height: 42px;
    }

    .chat-store-btn img {
      height: 21px;
    }

    .chat-mobile-slider {
      height: 260px;
      min-height: 240px;
    }

    .chat-mobile-slider .slider-container {
      height: 200px;
    }
  }

  /* Móviles muy pequeños (321-380px) - iPhone SE 1gen */
  @media (max-width: 380px) and (min-width: 321px) {
    .chat-mobile-layout {
      padding-top: 72px;
    }

    .chat-mobile-content {
      gap: 0.6rem;
      padding: 0.4rem 4%;
    }

    .chat-title {
      margin-bottom: 0.35rem;
    }

    .chat-title-line1 {
      font-size: clamp(24px, 6.5vw, 30px);
    }

    .chat-title-line2 {
      font-size: clamp(14px, 3.8vw, 18px);
    }

    .chat-subtitle {
      font-size: 11px;
      max-width: 85%;
      line-height: 1.3;
    }

    .chat-mobile-buttons {
      gap: 0.35rem;
    }

    .chat-cta {
      width: min(220px, 62vw);
      height: 44px;
      font-size: 13px;
      padding: 0 1.5rem;
    }

    .chat-store-btn {
      width: min(190px, 54vw);
      height: 40px;
      padding: 0 12px;
    }

    .chat-store-btn img {
      height: 20px;
    }

    .chat-mobile-slider {
      height: 250px;
      min-height: 230px;
    }

    .chat-mobile-slider .slider-container {
      height: 190px;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.2rem;
    }
  }

  /* Móviles ultra pequeños (<=320px) - iPhone 5 */
  @media (max-width: 320px) {
    .chat-mobile-layout {
      padding-top: 68px;
    }

    .chat-mobile-content {
      gap: 0.5rem;
      padding: 0.3rem 3%;
    }

    .chat-title {
      margin-bottom: 0.3rem;
    }

    .chat-title-line1 {
      font-size: 22px;
    }

    .chat-title-line2 {
      font-size: 13px;
    }

    .chat-subtitle {
      font-size: 10px;
      max-width: 82%;
      line-height: 1.25;
    }

    .chat-mobile-buttons {
      gap: 0.3rem;
    }

    .chat-cta {
      width: min(200px, 65vw);
      height: 40px;
      font-size: 12px;
      padding: 0 1.25rem;
    }

    .chat-store-btn {
      width: min(175px, 58vw);
      height: 36px;
      padding: 0 10px;
    }

    .chat-store-btn img {
      height: 18px;
    }

    .chat-mobile-slider {
      height: 230px;
      min-height: 210px;
    }

    .chat-mobile-slider .slider-container {
      height: 170px;
    }

    .chat-mobile-slider .slider-nav {
      margin-top: 0.15rem;
    }

    .chat-mobile-slider .nav-btn {
      width: 30px;
      height: 30px;
    }
  }

  /* Landscape mode para móviles */
  @media (max-width: 768px) and (max-height: 500px) and (orientation: landscape) {
    .chat-mobile-layout {
      padding-top: 60px;
      flex-direction: row;
      flex-wrap: wrap;
    }

    .chat-mobile-content {
      flex: 1;
      min-width: 50%;
      padding: 0.5rem 2%;
      gap: 0.5rem;
    }

    .chat-mobile-title {
      padding: 0;
    }

    .chat-title-line1 {
      font-size: clamp(20px, 5vw, 28px);
    }

    .chat-title-line2 {
      font-size: clamp(12px, 3vw, 18px);
    }

    .chat-subtitle {
      font-size: 11px;
    }

    .chat-mobile-buttons {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
    }

    .chat-badges {
      flex-direction: row;
      gap: 0.5rem;
    }

    .chat-cta {
      height: 38px;
      width: auto;
      min-width: 140px;
      font-size: 12px;
    }

    .chat-store-btn {
      height: 36px;
      width: auto;
      min-width: 130px;
    }

    .chat-store-btn img {
      height: 18px;
    }

    .chat-mobile-slider {
      width: 100%;
      height: 180px;
      min-height: 160px;
    }

    .chat-mobile-slider .slider-container {
      height: 140px;
    }
  }
</style>

<script>
  // Optimizar reproducción de video en mobile
  function initChatMobileVideo(): void {
    const video = document.querySelector('.chat-mobile-video') as HTMLVideoElement;
    if (!video) return;

    const playVideo = () => {
      video.play().catch(() => {
        document.addEventListener('touchstart', () => {
          video.play();
        }, { once: true });
      });
    };

    if (video.readyState >= 2) {
      playVideo();
    } else {
      video.addEventListener('loadeddata', playVideo, { once: true });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatMobileVideo);
  } else {
    initChatMobileVideo();
  }
</script>
