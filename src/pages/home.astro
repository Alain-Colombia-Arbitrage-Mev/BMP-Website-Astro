---
import Layout from '../layouts/Layout.astro';
import WelcomeHeader from '../components/WelcomeHeader.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
import GeometricBackground from '../components/GeometricBackground.astro';
---

<Layout title="BeMind Power - Home" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva." bodyClass="home-page">
  <div class="home-page-wrap relative min-h-[100dvh] w-full">
    <!-- Fondo como en home1.pen: negro, resplandor, logo BMP, imagen decorativa -->
    <div class="home-bg absolute inset-0 z-0">
      <GeometricBackground />
    </div>

    <!-- Navbar (diseño Pencil) -->
    <WelcomeHeader />

    <!-- Contenido principal: slider de características -->
    <main class="main-content relative z-10 min-h-[100dvh] w-full flex flex-col items-center justify-center pt-12 pb-8 px-4 overflow-hidden max-sm:pt-10">
      <FeatureSlider />
    </main>
  </div>
</Layout>

<style is:global>
  body.home-page {
    background: #000000;
    overflow-x: hidden;
  }

  body.home-page .home-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
  }
</style>
