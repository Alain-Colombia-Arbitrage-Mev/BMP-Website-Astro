---
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import FeatureSlider from '../components/FeatureSlider.astro';
import PageBackground from '../components/PageBackground.astro';
import SideGradients from '../components/SideGradients.astro';
import SupportButton from '../components/SupportButton.astro';
---

<Layout title="BeMind Power - Home" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva.">
  <!-- Fondo con brillo central -->
  <PageBackground />

  <!-- Gradientes laterales suaves -->
  <SideGradients />

  <!-- Header (mismo de la intro) -->
  <HomeHeader />

  <!-- Contenido principal -->
  <main class="main-content">
    <!-- Slider de características -->
    <FeatureSlider />
  </main>

  <!-- Botón flotante de soporte -->
  <SupportButton />
</Layout>

<style>
  .main-content {
    position: relative;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding-top: 50px;
    z-index: 1;
    overflow: hidden;
  }

  @media (min-width: 640px) {
    .main-content {
      padding-top: 70px;
      height: 100vh;
    }
  }
</style>
