---
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import VideoHeroBackground from '../components/VideoHeroBackground.astro';
import homeMenuUrl from '../scripts/home-menu.ts?url';
---

<Layout title="BeMind Power" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva.">
  <!-- Contenedor fullscreen -->
  <main class="relative h-screen w-screen min-h-[100svh] overflow-hidden">
    <!-- Video Background -->
    <VideoHeroBackground
      videoSrc="https://video.veltlix.com/Prehome%20Bmp%20-%20Presentacio%CC%81n%2002.mp4"
    />

    <HomeHeader />

    <!-- Skip Button -->
    <button class="glass absolute z-10 bottom-[clamp(16px,4vw,48px)] right-[clamp(16px,5vw,64px)] flex items-center gap-2 px-4 py-2 text-[20px] font-black text-[#e3e3e3] hover:bg-white/10 hover:text-white max-lg:text-[16px] max-sm:px-3 max-sm:text-[14px] 2xl:text-[24px]">
      <span data-i18n="skip">Omitir Intro</span>
      <svg class="h-5 w-5 max-sm:h-4 max-sm:w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7" />
      </svg>
    </button>
  </main>

  <script type="module" src={homeMenuUrl}></script>
</Layout>
