---
// Primera hoja / primera página del sitio.
// Diseño de referencia: home1.pen (frame "Home 11").
import Layout from '../layouts/Layout.astro';
import WelcomeHeader from '../components/WelcomeHeader.astro';
import GeometricBackground from '../components/GeometricBackground.astro';
---

<Layout title="BeMind Power - Bienvenida" description="BeMind Power: transformación personal y bienestar con tecnología inmersiva." bodyClass="welcome-page">
  <!-- Navbar flotante -->
  <WelcomeHeader />
  
  <!-- Hero completo con todos los elementos -->
  <GeometricBackground />
</Layout>

<style is:global>
  body.welcome-page {
    background: #000000;
    overflow-x: hidden;
    margin: 0;
    padding: 0;
  }
</style>
